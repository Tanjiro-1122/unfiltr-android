{
  "name": "unfiltr-android",
  "version": "2.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "doctor": "npx expo-doctor",
    "test:release": "node --test tests/release-safety.test.mjs",
    "test:unit": "vitest run",
    "sync:native:dry": "node scripts/sync-native-source.mjs --source ../unfiltr-native",
    "sync:native": "node scripts/sync-native-source.mjs --source ../unfiltr-native --apply",
    "validate": "npm run typecheck && npm run lint && npm run test:unit && npm run test:release && npm run doctor && npx expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.0.0",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.5",
    "expo-build-properties": "~57.0.6",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "^10.4.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "private": true
}