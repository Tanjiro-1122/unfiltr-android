{
  "expo": {
    "name": "Unfiltr by Javier",
    "slug": "unfiltr-by-javier",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/unfiltr-triquetra-logo.png",
    "scheme": "unfiltr",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.huertas.unfiltr",
      "versionCode": 23,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#06020F",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#A855F7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Unfiltr uses your camera so you can share photos with your companion."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Unfiltr accesses your photo library so you can share images with your companion."
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06020F",
          "image": "./assets/brand/unfiltr-triquetra-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#06020F",
            "image": "./assets/brand/unfiltr-triquetra-logo.png",
            "imageWidth": 180,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://unfiltrbyjavier2.vercel.app",
      "revenueCatGoogleApiKey": "goog_wLoZn1dKzpmoBadvgGkJkQXzuQw",
      "googleClientId": "1033825374489-l6l27elju2n2i0k5fug6jf0kb0rvvguh.apps.googleusercontent.com",
      "eas": {
        "projectId": "b5e183d4-c4fa-4eb0-8d00-5b70263449c3"
      }
    }
  }
}
